{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/livros/(.*).epub",
      "headers": [
        { "key": "Content-Type", "value": "application/epub+zip" },
        { "key": "Content-Disposition", "value": "attachment" }
      ]
    },
    {
      "source": "/livros/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
